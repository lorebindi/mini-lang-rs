// 1. Base Element
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
ident = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
number = @{ ASCII_DIGIT+ }
neg_number = {"(" ~ "-" ~ number ~ ")"}


// 2. Arithmetic Expression
expr   = { term ~ (add_op ~ term)* }
term   = { factor ~ (mul_op ~ factor)* }
factor = { number | ident | "(" ~ expr ~ ")" | neg_number }
add_op = { "+" | "-" }
mul_op = { "*" }

// 3. BoolExpr
bool_expr = { bool_and }

bool_and = { bool_not ~ (and_op ~ bool_not)* }
and_op = @{ "and" ~ !ASCII_ALPHANUMERIC }

bool_not = { not_op ~ bool_not | bool_atom }
not_op = @{ "not" ~ !ASCII_ALPHANUMERIC }

bool_atom = {
      bool_true
    | bool_false
    | expr ~ "<" ~ expr
    | bool_atom_bracket
}
bool_true  = @{ "true" ~ !ASCII_ALPHANUMERIC }
bool_false = @{ "false" ~ !ASCII_ALPHANUMERIC }
bool_atom_bracket = {"(" ~ bool_expr ~ ")"}

// 4. Statement
cmd = { stmt ~ (";" ~ stmt)* }

stmt = {
    if_stmt |
    while_stmt |
    assign |
    skip |
    bracket_cmd
}

assign     = { ident ~ ":=" ~ expr }
if_stmt    = { "if" ~ bool_expr ~ "then" ~ stmt ~ "else" ~ stmt }
while_stmt = { "while" ~ bool_expr ~ "do" ~ stmt }
skip = @{ "skip" ~ !ASCII_ALPHANUMERIC }
bracket_cmd = { "(" ~ cmd ~ ")" }

// 5. Program (Prog)
prog = {
    SOI ~
    "def" ~ "main" ~ "with" ~ "input" ~ ident ~ "output" ~ ident ~ "as" ~ cmd ~
    EOI
}
